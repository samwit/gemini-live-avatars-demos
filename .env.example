# ---------------------------------------------------------------------------
# Gemini Live Avatar demos - configuration
# Copy this file to .env and fill in ONE of the two auth options below.
# ---------------------------------------------------------------------------

# Option A: Agent Platform API key (express mode or a regular Cloud API key).
# The key must be allowed to call the "Agent Platform API" (aiplatform.googleapis.com).
# NOTE: a Gemini Developer API / AI Studio key will NOT work - avatars are
# only available on Gemini Enterprise Agent Platform.
GOOGLE_API_KEY=

# Option B: Application Default Credentials (gcloud auth application-default login)
# or your gcloud user login. Needs a project with the Agent Platform API enabled.
GOOGLE_CLOUD_PROJECT=

# Region that serves gemini-3.8-live (US and EU endpoints are available).
GOOGLE_CLOUD_LOCATION=us-central1

# Which auth to use: auto (API key if set, otherwise ADC), api_key, or adc
GEMINI_AUTH=auto

# Optional overrides
# GEMINI_LIVE_MODEL=gemini-3.8-live
# AVATAR_VIDEO_BITRATE=1500000   # bits/sec of the avatar video (default stream is ~5 Mbps)
# PORT=8000
# HOST=127.0.0.1                 # keep local; 0.0.0.0 exposes your credentials to your network
# ALLOWED_ORIGINS=               # extra browser origins, comma-separated (e.g. behind a proxy)
